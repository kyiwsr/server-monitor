# Copy this file to .env and adjust values, then run: docker-compose up --build
# docker-compose reads this .env automatically for ${VARIABLE} substitution.

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Public base URL of the backend (scheme + host, no trailing slash). Used to
# build the one-line agent installer command and the URLs inside install.sh.
# If left blank, the backend derives it from the incoming request host header
# (works for local/dev). Set it explicitly in production, e.g.
#   PUBLIC_BASE_URL=http://203.0.113.10:3000   or   https://monitor.example.com
PUBLIC_BASE_URL=

# How often (seconds) the backend checks for servers that have gone silent.
DOWN_CHECK_INTERVAL_SECONDS=30

# Data retention: metrics older than this many days are auto-deleted (MongoDB TTL).
METRIC_RETENTION_DAYS=30

# Email / SMTP configuration for alert notifications.
# Leave blank to disable email (alerts are still created and shown in the UI).
# Gmail example:   EMAIL_HOST=smtp.gmail.com   EMAIL_PORT=587
# Outlook example: EMAIL_HOST=smtp.office365.com EMAIL_PORT=587
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
